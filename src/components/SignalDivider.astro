---
// A tapered signal: quiet at the edges, with three offset traces at the center.
const traces = [0, 1.1, -1.1].map(phase => Array.from({ length: 251 }, (_, index) => {
  const x = index * 4;
  const envelope = Math.exp(-Math.pow((x - 500) / 225, 2));
  const y = 24 + Math.sin(x / 22 + phase) * 15 * envelope;
  return `${index ? 'L' : 'M'}${x},${y.toFixed(2)}`;
}).join(' '));
---
<div class="section-divider" aria-hidden="true">
  <svg viewBox="0 0 1000 48" preserveAspectRatio="none" focusable="false">
    <path class="signal-baseline" d="M0 24H1000" />
    {traces.map((path, index) => <path class:list={['signal-trace', { 'signal-primary': index === 0 }]} d={path} />)}
  </svg>
</div>
